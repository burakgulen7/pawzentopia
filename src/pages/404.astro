---
import Base from '../layouts/Base.astro';
import { languages, pagePath, url } from '../i18n';
---
<Base lang="fr" page="home" title="404" noindex>
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    {
      languages.map((l) => (
        <p lang={l.code} class="line">
          <span class="title">{l.dict.notFound.title}</span>
          <a class="textlink" href={url(pagePath('home', l.code))}>{l.dict.notFound.back}</a>
        </p>
      ))
    }
  </div>
</Base>

<style>
  .nf {
    padding-top: 90px;
    padding-bottom: 110px;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    margin-top: 22px;
  }
  .title {
    font-family: var(--serif);
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.03em;
  }
</style>
