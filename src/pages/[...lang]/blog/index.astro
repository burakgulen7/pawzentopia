---
import Base from '../../../layouts/Base.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getPosts } from '../../../lib/blog';
import { defaultLang, getLanguage, languages, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return languages.map((l) => ({
    params: { lang: l.code === defaultLang ? undefined : l.code },
    props: { lang: l.code },
  }));
}

const { lang } = Astro.props as { lang: Lang };
const t = getLanguage(lang).dict;
// Every blog page lists all published posts (any language), newest first.
const posts = await getPosts();
---
<Base lang={lang} page="blog" title={t.blog.title}>
  <section class="wrap blog">
    <h1>{t.blog.title}</h1>
    {
      posts.length ? (
        <div class="grid">
          {posts.map((post) => <BlogCard post={post} lang={lang} />)}
        </div>
      ) : (
        <p class="empty">{t.blog.empty}</p>
      )
    }
  </section>
</Base>

<style>
  .blog {
    padding-top: 80px;
    padding-bottom: 110px;
    min-height: 50vh;
  }
  h1 {
    font-size: clamp(40px, 5vw, 62px);
    line-height: 1.1;
    margin-bottom: 44px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .empty {
    max-width: 560px;
    padding: 34px 36px;
    border-radius: var(--radius-card);
    background: var(--mint);
    color: var(--muted);
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  @media (max-width: 1020px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 800px) {
    .blog {
      padding-top: 48px;
      padding-bottom: 70px;
    }
    h1 {
      margin-bottom: 28px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .empty {
      padding: 26px 22px;
      font-size: 19px;
    }
  }
</style>
