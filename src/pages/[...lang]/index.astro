---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Trust from '../../components/Trust.astro';
import Services from '../../components/Services.astro';
import Reviews from '../../components/Reviews.astro';
import Pricing from '../../components/Pricing.astro';
import Approach from '../../components/Approach.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import Social from '../../components/Social.astro';
import Urgent from '../../components/Urgent.astro';
import Contact from '../../components/Contact.astro';
import FindUs from '../../components/FindUs.astro';
import { defaultLang, languages, type Lang } from '../../i18n';

export function getStaticPaths() {
  return languages.map((l) => ({
    params: { lang: l.code === defaultLang ? undefined : l.code },
    props: { lang: l.code },
  }));
}

const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} page="home">
  <Hero lang={lang} />
  <Trust lang={lang} />
  <Services lang={lang} />
  <Reviews lang={lang} />
  <Pricing lang={lang} />
  <Approach lang={lang} />
  <LatestPosts lang={lang} />
  <Social lang={lang} />
  <Urgent lang={lang} />
  <Contact lang={lang} />
  <FindUs lang={lang} />
</Base>
