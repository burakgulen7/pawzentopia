---
import { getLanguage, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const t = getLanguage(Astro.props.lang).dict.urgent;
---
<section class="wrap urgent" id="urgence" aria-labelledby="urgent-title">
  <div class="box">
    <div class="copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="urgent-title">{t.heading}</h2>
      <p class="body">{t.body}</p>
      <p class="detail">{t.detail}</p>
    </div>
    <a class="pill pill--light" href="#contact">{t.cta}<span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .urgent {
    padding-top: 70px;
    padding-bottom: 70px;
  }
  .box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding: 44px 46px 50px 54px;
    border-radius: 28px;
    background: var(--cta);
    color: #fff;
  }
  .eyebrow {
    color: #bad5c4;
    font-size: 11px;
  }
  h2 {
    margin: 22px 0 22px -4px;
    font-size: 36px;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .body,
  .detail {
    max-width: 760px;
    color: #d6e7dc;
    font-size: 15px;
    line-height: 1.6;
  }
  .detail {
    margin-top: 8px;
  }
  .pill {
    flex-shrink: 0;
    min-width: 206px;
    padding-inline: 20px 26px;
  }
  @media (max-width: 800px) {
    .urgent {
      padding-top: 40px;
      padding-bottom: 50px;
    }
    .box {
      display: block;
      padding: 32px 20px 12px;
      border-radius: 22px;
    }
    .eyebrow {
      font-size: 10px;
    }
    h2 {
      margin: 16px 0 14px -1px;
      font-size: 26px;
      line-height: 34px;
    }
    .body,
    .detail {
      font-size: 13px;
      line-height: 20px;
    }
    .detail {
      margin-bottom: 24px;
    }
    .pill {
      min-width: 0;
      margin-bottom: 12px;
    }
  }
</style>
