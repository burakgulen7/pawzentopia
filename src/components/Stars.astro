---
/** Five stars (filled according to `value`), warm gold with sufficient contrast. Decorative: pair with text. */
interface Props {
  value: number;
  size?: number;
}
const { value, size = 16 } = Astro.props;
const path = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
---
<span class="stars" aria-hidden="true">
  {
    [1, 2, 3, 4, 5].map((i) => (
      <svg width={size} height={size} viewBox="0 0 24 24">
        <path d={path} fill={value >= i - 0.25 ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      </svg>
    ))
  }
</span>

<style>
  .stars {
    display: inline-flex;
    gap: 2px;
    color: #a66e0c;
    line-height: 0;
  }
</style>
