---
/** Simple monochrome line icons (inherit currentColor). */
interface Props {
  name: 'instagram' | 'tiktok' | 'facebook' | 'youtube' | 'google' | 'whatsapp' | 'phone' | 'mail';
  size?: number;
}
const { name, size = 22 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'tiktok' && (
    <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6" />
  )}
  {name === 'facebook' && <path d="M14.5 8H17V4.5h-2.5A3.5 3.5 0 0 0 11 8v2.5H8.5V14H11v6.5h3.5V14H17l.5-3.5h-3V8.5a.5.5 0 0 1 .5-.5z" />}
  {name === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10.5 9.5v5l4.3-2.5z" />
    </>
  )}
  {name === 'google' && <path d="M20 12.2c0 4.6-3.2 7.8-7.8 7.8a8 8 0 1 1 5.4-13.9M20 12h-7.5" />}
  {name === 'whatsapp' && (
    <>
      <path d="M4 20l1.2-4A8 8 0 1 1 8.3 19z" />
      <path d="M9.2 8.6c.3 2.9 2.4 5.2 5.3 5.9l1-1.2-1.6-.9-.8.7c-1-.4-1.9-1.3-2.4-2.4l.7-.8-.9-1.6z" />
    </>
  )}
  {name === 'phone' && (
    <path d="M5 4h3.5l1.5 4-2 1.3a10 10 0 0 0 6.7 6.7L16 14l4 1.5V19a1.8 1.8 0 0 1-2 1.8A15.8 15.8 0 0 1 3.2 6 1.8 1.8 0 0 1 5 4z" />
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
    </>
  )}
</svg>
