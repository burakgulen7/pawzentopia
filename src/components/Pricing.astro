---
import { boarding, dayCare, longStayDiscount, type BoardingRow } from '../config/prices';
import { fill, getLanguage, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = getLanguage(Astro.props.lang).dict.pricing;
const price = (n: number) => fill(t.price, { n });
const weight = ({ minKg: min, maxKg: max }: BoardingRow) => {
  if (min === undefined && max === undefined) return '';
  if (min === undefined) return fill(t.weightUpTo, { max: max! });
  if (max === undefined) return fill(t.weightOver, { min });
  return fill(t.weightRange, { min, max });
};
---
<section class="wrap pricing" id="tarifs" aria-labelledby="pricing-title">
  <div class="head">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="pricing-title">{t.heading}</h2>
    <p class="intro">{t.body}</p>
  </div>

  <div class="grid">
    <article class="price-card">
      <h3>{t.boardingTitle}</h3>
      <table>
        <thead>
          <tr>
            <th scope="col">{t.columns.size}</th>
            <th scope="col">{t.columns.weight}</th>
            <th scope="col" class="num">{t.columns.price}</th>
          </tr>
        </thead>
        <tbody>
          {
            boarding.map((row) => (
              <tr>
                <th scope="row"><span class="badge">{row.size}</span></th>
                <td class="weight">{weight(row)}</td>
                <td class="num amount">{price(row.price)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="discount">{fill(t.discount, { percent: longStayDiscount.percent, days: longStayDiscount.minDays })}</p>
    </article>

    <article class="price-card daycare">
      <h3>{t.dayCareTitle}</h3>
      <p class="from">{fill(t.dayCareFrom, { price: price(dayCare.from) })}</p>
      <p class="sub">{fill(t.dayCareSubscription, { price: price(dayCare.subscriptionFrom) })}</p>
    </article>
  </div>

  <div class="extras">
    <p>{t.extras}</p>
    <a class="textlink" href="#contact">{t.cta} <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .pricing {
    padding-top: 30px;
    padding-bottom: 96px;
  }
  .head {
    margin-bottom: 42px;
  }
  .eyebrow {
    padding-left: 3px;
  }
  h2 {
    margin: 22px 0 22px;
    font-size: 54px;
    line-height: 1.12;
  }
  .intro {
    max-width: 720px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 18px;
    align-items: stretch;
  }
  .price-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background: #fff;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 34px 36px 32px;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .price-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 40px rgba(41, 77, 61, 0.1);
    }
  }
  h3 {
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  thead th {
    padding: 0 0 12px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  tbody th,
  tbody td {
    padding: 13px 0;
    border-bottom: 1px solid #eef0e9;
    text-align: left;
    vertical-align: middle;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .num {
    text-align: right !important;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--mint-soft);
    font-size: 13px;
    font-weight: 700;
  }
  .weight {
    color: var(--muted);
    font-size: 15px;
    padding-inline: 12px !important;
  }
  .amount {
    font-family: var(--serif);
    font-size: 26px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .discount {
    margin-top: 16px;
    color: #a9654a;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
  }
  .daycare {
    display: flex;
    flex-direction: column;
  }
  .from {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-top: 8px;
  }
  .sub {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }
  .extras {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: 28px;
    padding-left: 3px;
  }
  .extras p {
    max-width: 820px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .extras .textlink {
    flex-shrink: 0;
  }
  @media (max-width: 1020px) {
    h2 {
      font-size: 46px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .extras {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 800px) {
    .pricing {
      padding-top: 40px;
      padding-bottom: 64px;
    }
    .head {
      margin-bottom: 28px;
    }
    h2 {
      margin: 12px 0 14px;
      font-size: 36px;
      line-height: 42px;
    }
    .intro {
      font-size: 14px;
      line-height: 21px;
    }
    .grid {
      gap: 14px;
    }
    .price-card {
      padding: 24px 18px 22px;
    }
    h3 {
      font-size: 21px;
      margin-bottom: 12px;
    }
    thead th {
      font-size: 11px;
    }
    .badge {
      min-width: 38px;
      height: 30px;
      font-size: 12px;
    }
    .weight {
      font-size: 13px;
      padding-inline: 8px !important;
    }
    .amount {
      font-size: 22px;
    }
    .discount {
      font-size: 13px;
    }
    .from {
      font-size: 24px;
    }
    .sub {
      font-size: 14px;
    }
    .extras p {
      font-size: 13px;
    }
  }
</style>
