---
import PriceGroup from './PriceGroup.astro';
import { getLanguage, pagePath, url, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const l = getLanguage(lang);
const t = l.dict.pricing;
const more = (key: 'pension' | 'creche' | 'petSitting' | 'education') => ({
  href: url(pagePath(`service:${key}`, lang)),
  label: `${l.services.pages[key].name} →`,
});
---
<section class="wrap pricing" id="tarifs" aria-labelledby="pricing-title">
  <div class="head">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="pricing-title">{t.heading}</h2>
    <p class="intro">{t.body}</p>
  </div>

  <div class="grid">
    <PriceGroup lang={lang} group="training" links={[more('education')]} />
    <PriceGroup lang={lang} group="boarding" links={[more('pension'), more('creche')]} />
    <PriceGroup lang={lang} group="visits" links={[more('petSitting')]} />
    <PriceGroup lang={lang} group="emergency" />
  </div>

  <div class="cta">
    <a class="pill" href="#contact">{t.cta}<span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .pricing {
    padding-top: 30px;
    padding-bottom: 96px;
  }
  .head {
    margin-bottom: 42px;
  }
  .eyebrow {
    padding-left: 3px;
  }
  h2 {
    margin: 22px 0 22px;
    font-size: 54px;
    line-height: 1.12;
  }
  .intro {
    max-width: 760px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }
  .cta {
    margin-top: 30px;
  }
  @media (max-width: 1020px) {
    h2 {
      font-size: 46px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 800px) {
    .pricing {
      padding-top: 40px;
      padding-bottom: 64px;
    }
    .head {
      margin-bottom: 28px;
    }
    h2 {
      margin: 12px 0 14px;
      font-size: 36px;
      line-height: 42px;
    }
    .intro {
      font-size: 14px;
      line-height: 21px;
    }
    .grid {
      gap: 14px;
    }
    .cta .pill {
      width: 100%;
    }
  }
</style>
