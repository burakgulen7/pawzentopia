---
import Icon from './Icon.astro';
import { contact, formspreeId, socials } from '../config/site';
import { fill, getLanguage, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getLanguage(lang).dict;
const c = t.contact;
const wa = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(c.whatsappMessage)}`;
const callLabel = fill(c.call, { phoneLocal: contact.phoneLocal, phoneIntl: contact.phoneIntl });
---
<section class="wrap contact" id="contact" aria-labelledby="contact-title">
  <div class="panel">
    <div class="info">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="contact-title">{c.heading}</h2>
      <p class="body">{c.body}</p>

      <div class="buttons">
        <a class="pill" href={wa} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} />{c.whatsapp}<span class="visually-hidden"> {t.ui.newTab}</span>
        </a>
        <a class="pill pill--outline" href={`tel:${contact.phoneE164}`}>
          <Icon name="phone" size={20} />{callLabel}
        </a>
      </div>
      <a class="mail" href={`mailto:${contact.email}`}><Icon name="mail" size={20} />{contact.email}</a>
    </div>

    <div class="side">
      <ul class="facts">
        <li>{c.area}</li>
        <li>{c.languages}</li>
        <li>{c.pricingNote}</li>
      </ul>

      <div class="social">
        <span>{c.social}</span>
        <ul>
          {
            socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.name} ${s.handle} ${t.ui.newTab}`}>
                  <Icon name={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    {
      formspreeId && (
        <form
          class="form"
          action={`https://formspree.io/f/${formspreeId}`}
          method="POST"
          data-contact-form
          data-error={fill(c.form.error, { email: contact.email })}
        >
          <input type="hidden" name="_language" value={lang} />
          <label>
            <span>{c.form.name}</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>{c.form.reply}</span>
            <input name="contact" type="text" autocomplete="email" required />
          </label>
          <label>
            <span>{c.form.message}</span>
            <textarea name="message" rows="6" required />
          </label>
          <button class="pill" type="submit">
            {c.form.send}
            <span aria-hidden="true">↗</span>
          </button>
          <p class="status" role="status" aria-live="polite" data-success={c.form.success} />
        </form>
      )
    }
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: send the form in the background and show a confirmation.
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.status')!;
      const button = form.querySelector<HTMLButtonElement>('button')!;
      button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = status.dataset.success ?? '';
        status.classList.remove('error');
      } catch {
        status.textContent = form.dataset.error ?? '';
        status.classList.add('error');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .contact {
    padding-bottom: 80px;
  }
  .panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 56px 54px;
    border-radius: 28px;
    background: var(--mint);
  }
  .side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0;
  }
  h2 {
    margin: 22px 0 18px -3px;
    font-size: 44px;
    line-height: 1.15;
  }
  .body {
    max-width: 520px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.6;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 12px;
    font-weight: 700;
    font-size: 15px;
    border-bottom: 1px solid transparent;
  }
  .mail:hover {
    border-color: currentColor;
  }
  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .facts li + li {
    margin-top: 6px;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    font-size: 14px;
    font-weight: 700;
  }
  .social ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition: background-color 0.18s ease;
  }
  .social a:hover {
    background: rgba(37, 68, 60, 0.08);
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 14px;
    font-weight: 700;
  }
  input,
  textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid #c5d9ce;
    border-radius: 14px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-weight: 400;
    font-size: 16px;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid #a9654a;
    outline-offset: 1px;
    border-color: var(--ink);
  }
  .form .pill {
    align-self: flex-start;
    cursor: pointer;
    font-family: inherit;
  }
  .form .pill:disabled {
    opacity: 0.6;
  }
  .status {
    min-height: 1.5em;
    font-weight: 700;
    font-size: 15px;
  }
  .status:global(.error) {
    color: #a9654a;
  }
  @media (max-width: 1020px) {
    .panel {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 800px) {
    .contact {
      padding-bottom: 50px;
    }
    .panel {
      padding: 32px 20px;
      border-radius: 22px;
    }
    h2 {
      margin: 14px 0 12px -1px;
      font-size: 30px;
    }
    .body {
      font-size: 15px;
    }
    .buttons {
      flex-direction: column;
      margin-top: 24px;
    }
    .buttons .pill {
      width: 100%;
    }
    .facts {
      font-size: 14px;
    }
    .form .pill {
      align-self: stretch;
    }
  }
</style>
