---
import { languages, pagePath, url, getLanguage, type Lang, type PageKey } from '../i18n';
interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = getLanguage(lang).dict;
---
<details class="lang" data-lang-switcher>
  <summary aria-label={`${t.ui.language} : ${getLanguage(lang).label}`}>
    <span>{lang.toUpperCase()}</span><span class="caret" aria-hidden="true">▾</span>
  </summary>
  <ul>
    {
      languages.map((l) => (
        <li>
          <a
            href={url(pagePath(page, l.code))}
            hreflang={l.code}
            lang={l.code}
            aria-current={l.code === lang ? 'true' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close the language list on outside click or Escape (works without JS too, via <details>).
  document.querySelectorAll<HTMLDetailsElement>('[data-lang-switcher]').forEach((el) => {
    document.addEventListener('click', (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false;
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && el.open) {
        el.open = false;
        el.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .lang {
    position: relative;
  }
  summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 48px;
    min-height: 44px;
    padding: 0 8px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.18s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: rgba(37, 68, 60, 0.07);
  }
  .caret {
    font-size: 10px;
    transition: transform 0.18s ease;
  }
  .lang[open] .caret {
    transform: rotate(180deg);
  }
  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 30;
    min-width: 160px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 16px 34px rgba(41, 77, 61, 0.14);
  }
  a {
    display: block;
    padding: 11px 14px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.3;
  }
  a:hover {
    background: var(--mint);
  }
  a[aria-current='true'] {
    font-weight: 700;
    background: var(--mint);
  }
</style>
