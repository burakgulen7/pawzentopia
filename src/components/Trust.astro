---
import { getLanguage, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const t = getLanguage(Astro.props.lang).dict;
---
<div class="wrap">
  <ul class="trust">
    {t.trust.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .trust {
    display: flex;
    justify-content: space-between;
    gap: 16px 40px;
    margin: 0;
    padding: 30px 0 32px 4px;
    list-style: none;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
  }
  li::before {
    content: '✳';
    margin-right: 8px;
    color: var(--ink);
    font-weight: 400;
    font-size: 14px;
  }
  @media (max-width: 1020px) {
    .trust {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }
  @media (max-width: 800px) {
    .trust {
      flex-direction: column;
      gap: 8px;
      padding: 24px 0 18px;
      font-size: 13px;
    }
    li::before {
      font-size: 12px;
    }
  }
</style>
