---
import { Picture } from 'astro:assets';
import { getPhoto } from '../config/photos';
import { getLanguage, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getLanguage(lang).dict.approach;
const photo = getPhoto('approach');
---
<section class="approach" id="approche" aria-labelledby="approach-title">
  <div class="wrap inner">
    <div class="portrait">
      <Picture
        src={photo.src}
        alt={photo.alt[lang]}
        formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={78}
        widths={[400, 600, 800, 1140]}
        sizes="(max-width: 800px) 92vw, 570px"
        style={`object-position:${photo.position}`}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="approach-title">{t.heading}</h2>
      <p class="body">{t.body}</p>
      <a class="textlink" href="#contact">{t.cta} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .approach {
    background: var(--approach);
  }
  .inner {
    display: grid;
    grid-template-columns: 570px 1fr;
    gap: 77px;
    align-items: start;
    padding-top: 40px;
    padding-bottom: 44px;
  }
  .portrait {
    height: 392px;
    border-radius: 60px 110px 110px 60px / 60px 110px 110px 60px;
    overflow: hidden;
  }
  .portrait :global(img),
  .portrait :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .copy {
    padding-top: 30px;
  }
  .eyebrow {
    padding-left: 4px;
    color: var(--eyebrow);
  }
  h2 {
    max-width: 520px;
    margin: 30px 0 34px;
    font-size: 42px;
    line-height: 60px;
  }
  .body {
    max-width: 470px;
    margin-left: 4px;
    color: #566c62;
    font-size: 17px;
    line-height: 28px;
    margin-bottom: 20px;
  }
  .textlink {
    margin-left: 4px;
  }
  @media (max-width: 1180px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
    .portrait {
      height: auto;
      aspect-ratio: 570 / 392;
    }
  }
  @media (max-width: 800px) {
    .inner {
      display: flex;
      flex-direction: column;
      gap: 36px;
      padding-top: 26px;
      padding-bottom: 72px;
    }
    .portrait {
      width: 100%;
      aspect-ratio: 350 / 232;
      border-radius: 70px;
    }
    .copy {
      padding-top: 0;
    }
    .eyebrow {
      padding-left: 2px;
    }
    h2 {
      margin: 16px 0 18px;
      font-size: 28px;
      line-height: 36px;
    }
    .body {
      margin-left: 2px;
      font-size: 14px;
      line-height: 21px;
    }
  }
</style>
